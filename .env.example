# Copy to .env and replace all placeholder values before starting.
POSTGRES_DB=inventory_order_db
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE=5242880
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=8080
